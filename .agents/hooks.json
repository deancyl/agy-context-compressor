{
  "agy-context-compressor": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./src/hooks/hook-runner.js pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

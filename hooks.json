{
  "agy-context-compressor": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "node ./src/hooks/hook-runner.js pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./src/hooks/hook-runner.js pre-invocation",
        "timeout": 5
      }
    ]
  }
}
